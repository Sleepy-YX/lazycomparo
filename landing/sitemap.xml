<?xml version="1.0" encoding="UTF-8"?>
<!-- Root-domain sitemap. The subdomains each ship their own
     (pcgames.lazycomparo.com/sitemap.xml lists every /game/<slug> page);
     they are listed here so a crawler that only finds lazycomparo.com still
     discovers both apps. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://lazycomparo.com/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>https://pcgames.lazycomparo.com/</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>https://mobile.lazycomparo.com/</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <!-- Extensionless: Cloudflare Pages serves how-we-rank.html at /how-we-rank.
       Do NOT add a trailing slash - that path 308-redirects and the sitemap
       would then point at a redirect (same trap as /gog, see PROJECT_STATE). -->
  <url><loc>https://lazycomparo.com/how-we-rank</loc><lastmod>2026-08-09</lastmod><changefreq>monthly</changefreq><priority>0.7</priority></url>
  <url><loc>https://lazycomparo.com/about</loc><lastmod>2026-08-09</lastmod><changefreq>monthly</changefreq><priority>0.6</priority></url>
  <url><loc>https://lazycomparo.com/privacy</loc><lastmod>2026-08-09</lastmod><changefreq>yearly</changefreq><priority>0.3</priority></url>
</urlset>
